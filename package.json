{
  "name": "telco-signal-platform",
  "version": "0.0.1",
  "private": true,
  "description": "Reference implementation (sandbox, synthetic data only). NOT approved for live data.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:deps": "npm audit --audit-level=high --omit=dev && npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "sandbox:setup": "tsx scripts/sandbox-setup.ts .sandbox",
    "sandbox:mocks": "tsx mock/run-mocks.ts",
    "sandbox:start": "tsx src/main.ts",
    "dast": "tsx tests/dast/run.ts .sandbox https://localhost:8443",
    "sandbox:admin": "tsx src/admin/main.ts",
    "sandbox:idp": "tsx mock/run-idp.ts",
    "dast:admin": "tsx tests/dast/admin.ts .sandbox",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "gen:portal": "tsx scripts/build-portal.ts",
    "gen:traceability": "tsx scripts/gen-traceability.ts",
    "load": "tsx tests/load/run.ts .sandbox https://localhost:8443 200 60 load-report.json",
    "worker": "tsx src/worker/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.3.0",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "undici": "8.13.1"
  }
}
